# Copy this file to .env and fill in your values
# NEVER commit .env to version control

# Anthropic API key — https://console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-api03-your-key-here

# HubSpot Private App token — https://app.hubspot.com/private-apps
HUBSPOT_API_KEY=pat-na1-your-token-here

# Path to Google service account JSON (inside container)
GOOGLE_SERVICE_ACCOUNT_JSON=/app/credentials/service-account.json
